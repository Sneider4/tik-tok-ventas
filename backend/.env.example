# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes permitidos (Angular dev server y dominio público del checkout), separados por coma
CORS_ORIGINS=http://localhost:4200

# --- Base de datos ---
DATABASE_URL=postgresql://oms:oms@localhost:5432/live_oms?schema=public

# --- Auth admin ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=admin@tienda.co
SEED_ADMIN_PASSWORD=CambiaEsta123!

# --- Archivos (comprobantes y guías) ---
STORAGE_DIR=./storage
MAX_RECEIPT_MB=5

# --- Checkout ---
# Horas después de terminar el Live en que el link sigue aceptando pedidos
CHECKOUT_GRACE_HOURS=24
SHIPPING_FLAT_COP=15000
# Envío gratis desde este subtotal (0 = desactivado)
FREE_SHIPPING_FROM_COP=150000
# Datos que ve el cliente para pagar
PAYMENT_NEQUI_NUMBER=3000000000
PAYMENT_DAVIPLATA_NUMBER=3000000000
PAYMENT_BANK_INFO=Bancolombia Ahorros 000-000000-00 a nombre de Tienda SAS
PAYMENT_ACCOUNT_HOLDER=Tienda SAS

# --- Remitente (aparece en la guía) ---
SENDER_NAME=Tienda Cosméticos
SENDER_PHONE=3000000000
SENDER_CITY_CODE=11001
SENDER_ADDRESS=Calle 00 # 00-00
SENDER_DOCUMENT=900000000

# --- Logística ---
# MOCK genera guías PDF de prueba sin llamar APIs externas. Opciones: MOCK | MIPAQUETE | SKYDROPX
SHIPPING_PROVIDER=MOCK
SHIPPING_BATCH_CONCURRENCY=3
MIPAQUETE_BASE_URL=
MIPAQUETE_API_KEY=
SKYDROPX_BASE_URL=
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
